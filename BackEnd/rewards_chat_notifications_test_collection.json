								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/employee/notifications",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"employee",
								"notifications"
							]
						},
						"description": "جلب جميع الإشعارات الخاصة بالموظف مرتبة من الأحدث إلى الأقدم."
					},
					"response": []
				},
				{
					"name": "عدد الإشعارات غير المقروءة (Get Unread Notifications Count)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/employee/notifications/unread-count",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"employee",
								"notifications",
								"unread-count"
							]
						},
						"description": "الحصول على عدد الإشعارات غير المقروءة فقط لعرض عداد الإشعارات بالواجهة."
					},
					"response": []
				},
				{
					"name": "تحديد إشعار كمقروء (Mark Notification As Read)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/employee/notifications/{{notification_id}}/read",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"employee",
								"notifications",
								"{{notification_id}}",
								"read"
							]
						},
						"description": "تعديل حالة إشعار معين إلى مقروء."
					},
					"response": []
				},
				{
					"name": "قراءة جميع الإشعارات (Mark All Notifications As Read)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/employee/notifications/read-all",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"employee",
								"notifications",
								"read-all"
							]
						},
						"description": "تحديث حالة جميع الإشعارات لتصبح مقروءة بضغطة زر واحدة."
					},
					"response": []
				}
			]
		},
		{
			"name": "6. تحفيز الأحداث لإصدار الإشعارات (Events Triggers - HR Role)",
			"item": [
				{
					"name": "قبول أو رفض طلب الموظف (HR Action - Approve/Reject Request)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{hr_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"approved\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/requests/1/status",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"requests",
								"1",
								"status"
							]
						},
						"description": "يقوم مسؤول الـ HR باعتماد أو رفض إجازة أو طلب للموظف (مثال: طلب برقم 1)، ويقوم النظام بإصدار إشعار (leave_approved) للموظف صاحب الطلب."
					},
					"response": []
				},
				{
					"name": "اعتماد وصرف الراتب للموظف (HR Action - Mark Payroll Paid)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{hr_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/payroll/1/pay",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"payroll",
								"1",
								"pay"
							]
						},
						"description": "يقوم الـ HR بوضع الراتب برقم 1 كـ Paid (مدفوع)، مما يطلق إشعاراً فورياً للموظف (payroll_ready) يخبره أن راتبه قد تم إيداعه."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "BASE_URL",
