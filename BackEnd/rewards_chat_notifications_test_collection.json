{
	"info": {
		"_postman_id": "c1f7a2db-8a5f-4c3e-b8cd-bf85ccfa9bb6",
		"name": "Huma-HR Employee Portal — Rewards, Peer Recognition, Chats & Notifications APIs",
		"description": "مجموعة اختبارات Postman كاملة لاختبار الباك اند لخصائص بوابة الموظف الجديدة: المكافآت والأرباح (Rewards)، تكريم الزملاء والشارات (Peer Recognitions)، نظام المحادثات الفورية والرسائل (Chats & Messaging)، ونظام الإشعارات المدمج (Notifications) في Huma-HR.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. المصادقة (Authentication)",
			"item": [
				{
					"name": "تسجيل دخول موظف (Login Employee)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.globals.set(\"employee_token\", jsonData.token);",
									"    pm.globals.set(\"token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"employee@company.com\",\n    \"password\": \"Employee@123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/auth/sessions",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"auth",
								"sessions"
							]
						},
						"description": "تسجيل دخول بحساب الموظف للحصول على التوكن وحفظه تلقائياً."
					},
					"response": []
				},
				{
					"name": "تسجيل دخول الـ HR (Login HR)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.globals.set(\"hr_token\", jsonData.token);",
									"    pm.globals.set(\"token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"hr@company.com\",\n    \"password\": \"Hr@123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/auth/sessions",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"auth",
								"sessions"
							]
						},
						"description": "تسجيل دخول بحساب الـ HR للحصول على التوكن وصلاحية إدخال تعديلات الرواتب وقبول الطلبات."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. نظام المكافآت والأرباح (Rewards & Bonuses)",
			"item": [
				{
					"name": "عرض المكافآت والرواتب الإضافية (Get Employee Rewards History)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/employee/rewards",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"employee",
								"rewards"
							]
						},
						"description": "جلب تاريخ أرباح ومكافآت الموظف الإضافية (Performance bonuses, Spot bonuses, Overtime) والمجموع السنوي الإجمالي."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. شارات وتكريم الزملاء (Peer Recognition)",
			"item": [
				{
					"name": "جلب تكريمات الموظف ووجبة التكريمات العامة (Get Recognitions)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/employee/recognitions",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"employee",
								"recognitions"
							]
						},
						"description": "جلب قائمة التكريمات التي حصل عليها الموظف الحالي (received)، وقائمة التكريمات المنشورة عامة لباقي الزملاء (public feed)."
					},
					"response": []
				},
				{
					"name": "إرسال تكريم وشارة إلى زميل (Send Recognition to Peer)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"recipient_id\": 2,\n    \"badge_type\": \"innovator\",\n    \"message\": \"شكراً جزيلاً على المساعدة في حل مشكلة قاعدة البيانات بالأمس، لقد أبدعت حقاً!\",\n    \"is_public\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/employee/recognitions",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"employee",
								"recognitions"
							]
						},
						"description": "إرسال بطاقة شكر وتكريم وشارة (rockstar, teamplayer, innovator, leader, creative) لأحد الزملاء وإرسال إشعار تلقائي له."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. نظام المحادثات والرسائل الفورية (Chats & Messaging)",
			"item": [
				{
					"name": "جلب قائمة الزملاء المتاحين للمحادثة (Get Chat Contacts)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.length > 0) {",
									"    pm.globals.set(\"chat_recipient_user_id\", jsonData.data[0].user_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/employee/chats/contacts",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"employee",
								"chats",
								"contacts"
							]
						},
						"description": "جلب قائمة الزملاء النشطين في الشركة لتمكين الموظف من بدء محادثة معهم."
					},
					"response": []
				},
				{
					"name": "إرسال رسالة فورية (Send Message / Start Conversation)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.conversation_id) {",
									"    pm.globals.set(\"conversation_id\", jsonData.data.conversation_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"recipient_id\": {{chat_recipient_user_id}},\n    \"body\": \"أهلاً بك! هل قمت بمراجعة التقرير الأسبوعي الجديد الخاص بالقسم؟\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/employee/chats/send",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"employee",
								"chats",
								"send"
							]
						},
						"description": "إرسال رسالة فورية لزميل (سيتم إنشاء محادثة تلقائياً إذا لم تكن موجودة مسبقاً) وإطلاق إشعار فوراً للمستلم."
					},
					"response": []
				},
				{
					"name": "عرض المحادثات النشطة (Get Active Conversations)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/employee/chats",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"employee",
								"chats"
							]
						},
						"description": "جلب جميع المحادثات النشطة للموظف الحالي مع عرض تفاصيل الزميل والرسالة الأخيرة والرسائل غير المقروءة."
					},
					"response": []
				},
				{
					"name": "جلب رسائل المحادثة (Get Conversation Messages)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/employee/chats/{{conversation_id}}/messages",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"employee",
								"chats",
								"{{conversation_id}}",
								"messages"
							]
						},
						"description": "جلب الرسائل داخل محادثة معينة مرتبة زمنياً، ووضع وسم مقروء (Read) على رسائل الطرف الآخر تلقائياً."
					},
					"response": []
				}
			]
		},
		{
			"name": "5. نظام الإشعارات الداخلي (Hr Notifications)",
			"item": [
				{
					"name": "جلب جميع الإشعارات (Get All Notifications)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.length > 0) {",
									"    pm.globals.set(\"notification_id\", jsonData.data[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
