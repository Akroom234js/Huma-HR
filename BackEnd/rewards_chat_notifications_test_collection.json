{
	"info": {
		"_postman_id": "c1f7a2db-8a5f-4c3e-b8cd-bf85ccfa9bb6",
		"name": "Huma-HR Employee Portal — Leaves & Vacations APIs",
		"description": "مجموعة اختبارات Postman كاملة لاختبار الباك اند لنظام الإجازات المتكامل (Leaves & Vacations) من جهة الموظف والـ HR، مع دعم أرصدة الإجازات، رفع المرفقات، والتحقق التلقائي من الأرصدة، وإنشاء أنواع إجازات جديدة ديناميكياً في Huma-HR.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. المصادقة (Authentication)",
			"item": [
				{
					"name": "تسجيل دخول موظف (Login Employee)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.globals.set(\"employee_token\", jsonData.token);",
									"    pm.globals.set(\"token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"employee@company.com\",\n    \"password\": \"Employee@123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/auth/sessions",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"auth",
								"sessions"
							]
						},
						"description": "تسجيل دخول بحساب الموظف للحصول على التوكن وحفظه تلقائياً."
					},
					"response": []
				},
				{
					"name": "تسجيل دخول الـ HR (Login HR)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.globals.set(\"hr_token\", jsonData.token);",
									"    pm.globals.set(\"token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"hr@company.com\",\n    \"password\": \"Hr@123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/auth/sessions",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"auth",
								"sessions"
							]
						},
						"description": "تسجيل دخول بحساب الـ HR للحصول على التوكن وصلاحية إدخال تعديلات الرواتب وقبول الطلبات."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. أرصدة الإجازات (Leave Balances)",
			"item": [
				{
					"name": "عرض أرصدتي كأرقام (Get My Leave Balances)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/my-leave-balances",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"my-leave-balances"
							]
						},
						"description": "جلب أرصدة إجازات الموظف الحالي (السنوية، المرضية، وأي إجازة مخصصة أخرى) مع عدد الأيام المتاحة، المستهلكة، والمتبقية ديناميكياً."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. أنواع الإجازات (Leave Types)",
			"item": [
				{
					"name": "عرض جميع أنواع الإجازات (Get All Leave Types)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/leave-types",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"leave-types"
							]
						},
						"description": "جلب كافة أنواع الإجازات المتاحة في النظام لملء قائمة الاختيار (Dropdown) عند تقديم الموظف لإجازة."
					},
					"response": []
				},
				{
					"name": "إضافة نوع إجازة جديد (HR - Create Custom Leave Type)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.globals.set(\"custom_leave_type_id\", jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{hr_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nameEn\": \"Bereavement Leave\",\n    \"nameAr\": \"إجازة وفاة / عزاء\",\n    \"allocation\": 3,\n    \"descEn\": \"Paid leave for the death of an immediate family member.\",\n    \"descAr\": \"إجازة مدفوعة الأجر في حال وفاة قريب من الدرجة الأولى.\",\n    \"isPaid\": true,\n    \"requiresApproval\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/leave-types",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"leave-types"
							]
						},
						"description": "إضافة نوع إجازة مخصص جديد بواسطة الـ HR. سيقوم النظام تلقائياً بإنشاء سجل رصيد إجازة (Leave Balance) بقيمة 3 أيام لكل الموظفين الحاليين في الشركة فور إنشائها."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. طلبات الإجازات (Leaves Requests)",
			"item": [
				{
					"name": "تقديم طلب إجازة (Employee - Submit Leave Request)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.globals.set(\"leave_request_id\", jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"type\": \"Annual Leave\",\n    \"reason\": \"قضاء عطلة سنوية للاستجمام مع العائلة\",\n    \"details\": {\n        \"start_date\": \"2026-06-15\",\n        \"duration\": 5\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/requests",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"requests"
							]
						},
						"description": "تقديم طلب إجازة سنوية لمدة 5 أيام. سيقوم النظام بالتحقق أولاً من رصيد الموظف المتاح وإرجاع خطأ 422 إذا كان الرصيد غير كافٍ."
					},
					"response": []
				},
				{
					"name": "اختبار تجاوز الرصيد المتاح (Validation Test - Insufficient Balance)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"type\": \"Annual Leave\",\n    \"reason\": \"طلب إجازة طويلة تفوق الرصيد\",\n    \"details\": {\n        \"start_date\": \"2026-08-01\",\n        \"duration\": 30\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/requests",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"requests"
							]
						},
						"description": "محاولة تقديم طلب إجازة لمدة 30 يوماً بينما الرصيد السنوي الأقصى للموظف هو 24 يوماً. يجب أن يرفض الباك اند ويرجع خطأ 422 برصيد غير كافٍ."
					},
					"response": []
				},
				{
					"name": "عرض طلباتي الشخصية (Employee - Get My Requests)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{employee_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/my-requests",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"my-requests"
							]
						},
						"description": "جلب كافة الطلبات التي قدمها الموظف الحالي فقط وحالاتها الحالية (موافقة، معلقة، مرفوضة)."
					},
					"response": []
				},
				{
					"name": "عرض كافة طلبات الإجازة بالمؤسسة (HR - View All Requests)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{hr_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/requests?status=all&type=all",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"requests"
							],
							"query": [
								{
									"key": "status",
									"value": "all"
								},
								{
									"key": "type",
									"value": "all"
								}
							]
						},
						"description": "صلاحية الـ HR لعرض كافة طلبات الإجازات لجميع الموظفين في المؤسسة مع الإحصائيات (Pending, Approved, Rejected) والفرز."
					},
					"response": []
				},
				{
					"name": "اتخاذ قرار بالقبول والخصم من الرصيد (HR - Approve Leave Request)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{hr_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"approved\",\n    \"reason\": \"تم قبول طلب إجازتك السنوية بنجاح، استمتع بوقتك!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/requests/{{leave_request_id}}/status",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"requests",
								"{{leave_request_id}}",
								"status"
							]
						},
						"description": "قرار الـ HR بقبول طلب الإجازة. عند القبول، يقوم الباك اند بخصم 5 أيام تلقائياً من رصيد الإجازات السنوية للموظف وإرسال إشعار فوري (leave_approved) لحسابه."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "BASE_URL",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		}
	]
}